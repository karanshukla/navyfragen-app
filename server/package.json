{
  "name": "navyfragen-server",
  "version": "1.0.0",
  "description": "For answering anonymous questions and posting them to Bluesky",
  "author": "Karan Shukla",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch --no-clear-screen src/index.ts | bunx --bun pino-pretty",
    "start": "bun src/index.ts",
    "lexgen": "bunx --bun lex gen-server ./src/lexicon ./lexicons/*",
    "clean": "bunx --bun rimraf coverage",
    "lint": "bunx --bun oxlint .",
    "lint:fix": "bunx --bun oxlint . --fix",
    "typecheck": "bunx --bun tsc -p tsconfig.check.json --noEmit",
    "test": "bun test --isolate --no-env-file --preload ./src/tests/test-bootstrap.js src/tests/",
    "test:watch": "bun test --isolate --no-env-file --watch --preload ./src/tests/test-bootstrap.js src/tests/",
    "test:coverage": "bun test --isolate --no-env-file --coverage --preload ./src/tests/test-bootstrap.js src/tests/",
    "publish-lexicons": "bun src/scripts/publish-lexicons.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "oxlint --fix"
    ]
  },
  "dependencies": {
    "@atproto/api": "^0.20.40",
    "@atproto/common": "^0.8.0",
    "@atproto/identity": "^0.5.9",
    "@atproto/lexicon": "^0.7.11",
    "@atproto/oauth-client-node": "^0.5.3",
    "@atproto/sync": "^0.4.4",
    "@atproto/syntax": "^0.7.4",
    "@atproto/xrpc-server": "^0.12.2",
    "@axiomhq/pino": "^2.0.0",
    "@hono/zod-validator": "^0.9.0",
    "@types/cryptr": "^4.0.3",
    "@types/web-push": "^3.6.4",
    "cryptr": "^6.4.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "hono": "^4.13.2",
    "hono-rate-limiter": "^0.5.3",
    "iron-session": "^8.0.4",
    "kysely": "^0.29.5",
    "multiformats": "^14.0.5",
    "obscenity": "^0.4.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "uhtml": "^5.0.9",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.10.10",
    "@types/bun": "1.3.14",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "oxlint": "^1.78.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
