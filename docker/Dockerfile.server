# Bun runtime image (#268, #271). The server runs TypeScript directly under Bun
# (no tsup/bundle step — Bun resolves the #/ tsconfig paths alias and TS natively).
FROM oven/bun:1.3-alpine AS builder
WORKDIR /app

# sharp ships prebuilt musl binaries; vipsthumbnail is only needed when sharp
# falls back to a system libvips (it doesn't on alpine with the prebuilt).
RUN apk add --no-cache python3 make g++

# Copy workspace manifests so bun install can use the root lock file. patches/
# must be present: patchedDependencies in package.json applies
# patches/@atproto-labs%2Ffetch-node@0.3.5.patch during bun install (#270).
COPY package.json bun.lock ./
COPY patches/ ./patches/
COPY server/package.json ./server/
COPY client/package.json ./client/

# Install all deps (workspaces), applying the patch. No postinstall build step
# remains (tsup was removed when the runtime moved to Bun source-first).
RUN bun install --frozen-lockfile

# Strip devDependencies before copying to the runtime image. Use --omit dev
# (not --production): --omit dev traverses workspaces, so the server workspace's
# prod deps are kept; --production only prunes to the root package's deps and
# drops the workspace's runtime dependencies.
RUN bun install --frozen-lockfile --omit dev

# ── Runtime ──────────────────────────────────────────────────────────────────
# Bun's isolated node_modules layout puts each workspace's deps under
# <workspace>/node_modules as symlinks into the shared /app/node_modules/.bun
# store. The runtime image preserves that layout plus the server source (run
# directly by Bun — no compiled dist/).
FROM oven/bun:1.3-alpine
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server/node_modules ./server/node_modules
COPY server/package.json server/tsconfig.json ./server/
COPY server/src ./server/src
COPY server/lexicons ./server/lexicons

WORKDIR /app/server
EXPOSE 3000

# Run the TypeScript source directly under Bun.
CMD ["bun", "src/index.ts"]
